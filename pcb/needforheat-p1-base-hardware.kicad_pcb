	(footprint "p1base:LED_LiteOn_LTST-S220_SideView"
		(layer "F.Cu")
		(uuid "80fea6b3-7989-487a-84be-df9804c822df")
		(at 111.7 101.2)
		(descr "Lite-On LTST-S220 side-looking SMD LED (KGKT green, KSKT yellow, KRKT red), about 2.2 x 1.0 mm. Light leaves the body towards -y (the arrow on F.Fab), so with rotation 0 it shines at the top board edge. Pads cover the pad centres of all three LCSC footprints (+/-0.98 to +/-1.25 mm). Pad 1 = cathode (marked by the line on F.Fab; no silkscreen, the part sits at the board edge). VERIFY body depth, lens height and lens side against the Lite-On drawing and the JLCPCB placement preview.")
